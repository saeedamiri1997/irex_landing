# Local default: applications are logged, not sent through Resend.
EMAIL_DELIVERY_MODE=log
RESEND_API_KEY=
APPLICATION_EMAIL=
RESEND_FROM_EMAIL=

# Cloudflare's documented test credentials for local development only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Production must set EMAIL_DELIVERY_MODE=resend plus real Resend and Turnstile credentials.
